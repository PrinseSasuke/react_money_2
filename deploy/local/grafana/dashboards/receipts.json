{
  "uid": "receipts-local",
  "title": "Сервис чеков",
  "tags": [
    "receipts"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "type": "text",
      "title": "Что здесь",
      "options": {
        "mode": "markdown",
        "content": "Путь чека: **receipts-api** принимает → очередь **NATS** → **receipts-worker** разбирает → трата в **core-api**.\n\nГлавный ранний сигнал — **длина очереди и её прогноз**: если прогноз уходит вверх, worker не успевает раньше, чем это заметят пользователи.\n\nАлерты: http://localhost:9090/alerts"
      },
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 16,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Сработавшие алерты",
      "description": "ALERTS из Prometheus",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (alertname) (ALERTS{alertstate=\"firing\"})",
          "legendFormat": "{{alertname}}",
          "refId": "A"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Очередь: ждут разбора и прогноз через 10 мин",
      "description": "Из экспортёра NATS — видно и когда worker лежит. Прогноз = predict_linear за 2 мин; алерт при прогнозе > 1000",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "jetstream_consumer_num_pending{consumer_name=\"receipts-worker\"}",
          "legendFormat": "ждут",
          "refId": "A"
        },
        {
          "expr": "clamp_min(predict_linear(jetstream_consumer_num_pending{consumer_name=\"receipts-worker\"}[2m], 600), 0)",
          "legendFormat": "прогноз через 10 мин",
          "refId": "B"
        },
        {
          "expr": "jetstream_consumer_num_ack_pending{consumer_name=\"receipts-worker\"}",
          "legendFormat": "в работе у worker",
          "refId": "C"
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Поток чеков: приняты и обработаны (в секунду)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (source) (rate(receipts_received_total[1m]))",
          "legendFormat": "принято: {{source}}",
          "refId": "A"
        },
        {
          "expr": "sum by (result) (rate(receipts_processed_total[1m]))",
          "legendFormat": "обработано: {{result}}",
          "refId": "B"
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Возраст самой старой задачи",
      "description": "Сколько ждёт чек, стоящий в очереди дольше всех (метрика worker)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "receipts_queue_oldest_age_seconds",
          "legendFormat": "старейшая задача",
          "refId": "A"
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Разбор чека и вызов core-api, p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(receipts_parse_duration_seconds_bucket[1m])))",
          "legendFormat": "разбор",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, code) (rate(receipts_core_api_duration_seconds_bucket[1m])))",
          "legendFormat": "core-api {{code}}",
          "refId": "B"
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Повторы по причинам (в секунду)",
      "description": "Временные ошибки: worker вернул задачу в очередь с задержкой",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(receipts_retries_total[1m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "receipts-api: ответы по кодам",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 40,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum by (code) (rate(receipts_http_request_duration_seconds_count{route=~\"/api/receipts.*\"}[1m]))",
          "legendFormat": "{{code}}",
          "refId": "A"
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "receipts-api: время приёма чека",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(receipts_http_request_duration_seconds_bucket{route=\"/api/receipts/\"}[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(receipts_http_request_duration_seconds_bucket{route=\"/api/receipts/\"}[1m])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "id": 9,
      "gridPos": {
        "x": 8,
        "y": 22,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "DLQ",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "jetstream_stream_total_messages{stream_name=\"RECEIPTS_DLQ\"}",
          "legendFormat": "задач в receipts.dlq",
          "refId": "A"
        },
        {
          "expr": "sum(increase(receipts_dlq_total{status_written=\"false\"}[30m])) or on() vector(0)",
          "legendFormat": "без записанного статуса (нужен человек)",
          "refId": "B"
        }
      ],
      "id": 10,
      "gridPos": {
        "x": 16,
        "y": 22,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Сервисы живы (1 = да)",
      "description": "up из Prometheus: отвечает ли /metrics",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "up{job=~\"receipts-api|receipts-worker|nats|seaweedfs\"}",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ],
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 8
      }
    }
  ]
}
