# Copy to deploy/local/.env (it is git-ignored). Local-only values, never real secrets.
JWT_SECRET=local_dev_only_change_me
RECEIPTS_DB_PASSWORD=receipts_local
# S3 key pair for SeaweedFS (photos of receipts)
S3_ACCESS_KEY=receipts_local
S3_SECRET_KEY=receipts_local_secret

# Test user that scripts/e2e.mjs registers in the LOCAL core-api (only on this laptop's database).
E2E_EMAIL=e2e@receipts.local.test
E2E_PASSWORD=e2e_local_password

# Worker tuning and failure scenarios (ТЗ, section 8)
# WORKER_CONCURRENCY=4
# PARSER_DELAY_MS=0
# PARSER_FAIL_RATE=0

# Uncomment if port 5432 is already taken on the laptop.
# PG_PORT=5433
