# Copy to mobile/.env (git-ignored). Addresses the phone uses to reach the services.
# During development: the laptop's address in the home Wi-Fi network (ipconfig → IPv4 address),
# phone and laptop on the same Wi-Fi, local docker compose running (deploy/local).
EXPO_PUBLIC_CORE_API_URL=http://192.168.1.10:4000
EXPO_PUBLIC_RECEIPTS_API_URL=http://192.168.1.10:3100
